CONTACT_TO_EMAIL=buddiesmensspa@gmail.com
CONTACT_FROM_EMAIL=
# Required in production: comma-separated https origins allowed to post forms,
# e.g. https://www.buddiesspa.com,https://buddiesspa.com. When it's empty, the
# production site rejects every form (403); previews and local dev still work.
CONTACT_ALLOWED_ORIGINS=
RESEND_API_KEY=
# Google reviews (Places API New). Keep the key server-side only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Build-time. Set to true while the site is a client preview to keep it out
# of search engines (adds X-Robots-Tag: noindex, nofollow to every response
# and a Disallow-all robots.txt). Leave unset for the public launch.
SITE_NOINDEX=
