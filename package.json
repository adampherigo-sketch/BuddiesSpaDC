{
  "name": "buddies-spa-site",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Buddies Spa, The Queer Spa DC. Static site on Netlify; booking, payments and gift cards stay in Square.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/adampherigo-sketch/BuddiesSpaDC.git"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js --open",
    "build": "node scripts/build-site.js",
    "test": "node --test",
    "security:check": "node scripts/security-check.js",
    "security-check": "node scripts/security-check.js",
    "check-links": "node scripts/check-links.js",
    "verify": "npm test && npm run build && npm run security:check",
    "preview": "npm run build && python3 -m http.server 5503 --directory dist",
    "placeholders": "node scripts/list-placeholders.js",
    "launch-check": "npm run verify && node scripts/list-placeholders.js --strict"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "2.0.0",
    "sharp": "0.35.5"
  }
}
